<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 좌석 색상 (예: 파란색) -->
    <solid android:color="#2196F3" />

    <!-- 테두리 -->
    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />

    <!-- 둥근 모서리 -->
    <corners android:radius="4dp" />
</shape>
